{
  "name": "myplanner",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "start": "npm run start --workspace=backend",
    "client": "npm run dev --workspace=frontend", 
    "dev": "concurrently \"npm run start\" \"npm run client\"",
    "build": "npm run build --workspace=frontend"
  },
  "devDependencies": {
    "concurrently": "^7.0.0"
  }
}
